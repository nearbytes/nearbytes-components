{
  "name": "nearbytes-components",
  "version": "0.1.0",
  "description": "App-level NearBytes component library built on nearbytes-widgets (Svelte 5 + stores).",
  "type": "module",
  "license": "MIT",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "refresh": "node scripts/refresh.mjs",
    "dev": "node scripts/refresh.mjs && node scripts/watch-build.mjs",
    "dev:fast": "node scripts/watch-build.mjs",
    "build": "svelte-package",
    "prepack": "svelte-package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-package"
  },
  "peerDependencies": {
    "nearbytes-widgets": "*",
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@lucide/svelte": "^0.482.0",
    "nearbytes-widgets": "github:nearbytes/nearbytes-widgets"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "nearbytes-chat": "github:nearbytes/nearbytes-chat",
    "nearbytes-files": "github:nearbytes/nearbytes-files",
    "nearbytes-skeleton": "github:nearbytes/nearbytes-skeleton",
    "nearbytes-widgets": "github:nearbytes/nearbytes-widgets",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "packageManager": "yarn@4.15.0"
}
