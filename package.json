{
  "name": "nearbytes-components",
  "version": "0.1.0",
  "description": "App-level NearBytes component library built on nearbytes-widgets (Svelte 5 + stores).",
  "type": "module",
  "license": "MIT",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "refresh": "node scripts/refresh.mjs",
    "dev": "node scripts/dev-bootstrap.mjs && node scripts/watch-build.mjs",
    "dev-local": "NEARBYTES_LOCAL_DEPS=1 node scripts/dev-bootstrap.mjs && node scripts/watch-build.mjs",
    "dev:fast": "node scripts/watch-build.mjs",
    "build": "svelte-package",
    "prepack": "svelte-package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-package",
    "test": "yarn check"
  },
  "peerDependencies": {
    "nearbytes-widgets": "*",
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@lucide/svelte": "^0.482.0",
    "nearbytes-widgets": "https://github.com/nearbytes/nearbytes-widgets.git#commit=66d561ae5dfd497224d8a0cdca29b56fd341a53f"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "nearbytes-chat": "https://github.com/nearbytes/nearbytes-chat.git#commit=e650c1720b00902c0f98a14af78435ba39526b37",
    "nearbytes-files": "https://github.com/nearbytes/nearbytes-files.git#commit=7b1c3326c7ce40cb7a84fe3d98beb7d6e6e6466f",
    "nearbytes-skeleton": "https://github.com/nearbytes/nearbytes-skeleton.git#commit=9531ab1a0fd89b12f977f32220697b5b886c64a4",
    "nearbytes-widgets": "https://github.com/nearbytes/nearbytes-widgets.git#commit=66d561ae5dfd497224d8a0cdca29b56fd341a53f",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "packageManager": "yarn@4.15.0"
}
